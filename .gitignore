# --- Reference / scratch material kept locally but never committed -----------
# All of these are dev-time scratch areas — not part of the polished package.
# They live alongside the repo for cross-reference and regression-suite
# development, but their contents do not enter git history.

# Local clone of HCIPy for cross-reference
hcipy/

# Local clone of the legacy v1.x canonical package
TelescopeSim/

# Forks of the legacy class kept for dev cross-reference
variants/

# Setup notebooks + configs scraped from prior projects
test_fixtures/

# Working design-rationale doc; superseded by docs/ when published
DESIGN_CHALLENGES.md

# AI-assistant context for refactor work
CLAUDE.md

# Working implementation notes (scratchpad; not part of polished package)
IMPLEMENTATION_NOTES.md

# Framework experiments / prototype components (local scratchpad)
experiments/

# Legacy-fixture capture scripts — dev-only tooling that imports legacy code
# from local-only directories. Once a digest is captured and committed under
# fixtures/runner/digests/, the capture script is no longer needed at runtime.
fixtures/runner/capture_*.py
fixtures/runner/run_legacy*.py

# Pickle files are not version-portable across HCIPy/Python releases
*.pkl

# --- Generated golden-output digests (commit these once captured) -------------
# Note: these ARE committed; this rule just excludes any raw tensor dumps
fixtures/runner/raw_tensors/

